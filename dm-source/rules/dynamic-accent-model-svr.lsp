;; ---------------------------------------------
;; ------- Main function -----------------------
;; ---------------------------------------------

(defun integrated-dynamics (quant &key (model :svr) (pitch 1)(timing 1)(meter 1) (phrasing 1) (high-loud 1))
  "Performance rule for an integrated model of melodic dynamics including both rules and features" 
  (case model
      (:svr   (dynamic-accent-jf2023-svr quant :pitch pitch :timing timing :phrasing phrasing :meter meter :high-loud high-loud))
      (:mlr   (dynamic-accent-jf2023-mlr quant :pitch pitch :timing timing :phrasing phrasing :meter meter :high-loud high-loud))
      (t (warn "melodic-dynamics: wrong model name"))
      ))

; with scaling of groups
; for testing: (dynamic-accent-jf2023-svr 1 :pitch 1 :timing 1 :meter 1 :phrasing 1 :high-loud 1)
(defun dynamic-accent-jf2023-svr (quant &key (pitch 1)(timing 1)(meter 1) (phrasing 1) (high-loud 1))
  "Performance rule for dynamic accent model." 
  (if (not *svr-model*) (setq *svr-model* (alist-to-hash *svr-model-alist*)))
  (mark-dynamic-accent-jf2023-svr :pitch pitch :timing timing :phrasing phrasing :meter meter :high-loud high-loud)
  (apply-sl-accent-svr quant)
  (rem-all :sl-accent-svr) )
;
(defun apply-sl-accent-svr (quant)
  "Apply the computed accent value to SL."
  (each-note-if (this :sl-accent-svr) (then (add-this 'sl (* quant (this :sl-accent-svr))))) )

(defun hash-to-alist (ht)
  (let (result)
    (maphash (lambda (k v)
               (push (cons k v) result))
             ht)
    result))

(defun alist-to-hash (alist &optional (test #'equal))
  (let ((ht (make-hash-table :test test)))
    (dolist (pair alist)
      (setf (gethash (car pair) ht) (cdr pair)))
    ht))

;; ---------------------------------------------------------------------
;; --- Apply the SVR dynamics model with all the calculation in lisp ---
;; ---------------------------------------------------------------------

(defun svrmod-rbf-kernel (x y gamma)
  "Compute the RBF (Gaussian) kernel between vectors X and Y."
  (let ((sum 0.0))
    (dotimes (i (length x) (exp (- (* gamma sum))))
      (incf sum (expt (- (nth i x) (nth i y)) 2)))))

(defun svrmod-svr-predict (x model)
  "Apply a LIBSVM-style SVR model to one input X (a list or vector)."
  (let* ((svs (gethash "SVs" model))
         (coefs (gethash "sv_coef" model))
         (bias (gethash "rho" model))
         (gamma (gethash "gamma" model))
         (sum 0.0))
    (dotimes (i (length svs) (+ sum (- bias))) 
      (incf sum (* (car (nth i coefs))
                   (svrmod-rbf-kernel x (nth i svs) gamma))))))

(defun mark-dynamic-accent-jf2023-svr (&key (pitch 1)(timing 1)(meter 1) (phrasing 1) (high-loud 1))
"Mark the dynamic accent using SVR prediction."
 ;compute all features
  (mark-48-accent-features)
 ; mark the model result
  (each-note-if
    (this :ni)
    (then
      ; List of the 34 features
      (let ((x (list 
                 ;pitch contour
                 (* (this :f0-pos-dist-mean) pitch)
                 (* (this :f0-neg-dist-mean) pitch)
                 (* (this :f0-pos-dist-mean-1bar) pitch)   
                 (* (this :f0-bef-pos-leap-p) pitch) 
                 (* (this :f0-aft-pos-leap-log) pitch)  
                 (* (this :f0-aft-neg-leap-log) pitch)  
                 (* (this :f0-aft-leap2-log) pitch)
                 (* (this :f0-bef-leap2-log) pitch)
                 (* (this :f0-pos-peak-log) pitch)  
                 (* (this :f0-neg-peak-log) pitch)
                 (* (this :f0-pos-peak3-p) pitch)
                 (* (this :f0-first-arp-down-p) pitch)
                 ;tempo
                 (* (this :dr-ndr) timing)
                 (* (this :dr-very-short-note) timing)  
                 ;timing patterns
                 (* (this :dr-short-before-p) timing)
                 (* (this :dr-short2-before-p) timing)  
                 (* (this :dr-short-after-p) timing)
                 (* (this :dr-first-short-p) timing)
                 (* (this :dr-short-between-long-p) timing)  
                 (* (this :dr-long-after-p) timing)
                 ;simple phrasing
                 (* (this :ph-rest-before-or-first) phrasing)
                 (* (this :ph-rest-after-or-last) phrasing)
                 ;meter
                 (* (if (this :beat0) 1 0) meter)  
                 (* (if (this :beat1) 1 0) meter)
                 (* (if (this :beat2) 1 0) meter)
                 ;automatic rules
                 (* (this :ru-chromch-dsl) pitch) 
                 (* (this :ru-hiloud-dsl) high-loud)
                 (* (this :ru-durcont-dsl)  timing) 
                 (* (this :ru-punct-dro) phrasing)  
                 (* (this :ph-punct-first) phrasing)
                 ;phrasing rules
                 (* (this :ru-ph4-dsl) phrasing)
                 (* (this :ru-ph5-dsl) phrasing)
                 (* (this :ru-ph6-dsl) phrasing)
                 (* (this :ru-ph6-start) phrasing)
                 ))
            (xz nil)
            (xmu (gethash "Xmu" *svr-model*))
            (xsigma (gethash "Xsigma" *svr-model*))
            (ymu (gethash "Ymu" *svr-model*))
            (ysigma (gethash "Ysigma" *svr-model*)) )
        ;(print-ll "xmu " xmu " xsigma " xsigma)

        ; z-score transformation of features using coeff. from training data (included in model from matlab)
        (dotimes (i (length x))
          (setq xz (append xz (list (/ (- (nth i x) (nth i xmu)) (nth i xsigma))))) ) 
        ; (print xz)
        ; apply the model and transform back from z-zcore of training data (Y2_fit = Ysigma*Y2z_fit+Ymu; in matlab)
        ; also covert from double to short float
        (set-this :sl-accent-svr (coerce (+ (* (svrmod-svr-predict xz *svr-model*) ysigma) ymu) 'short-float)) )))
  (remove-48-accent-features) )

